# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pocket_operator

# ==========================================
# GEMINI AI CONFIGURATION
# ==========================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
INTERNAL_KEY=replace-with-strong-random-secret
DEV_TOKEN=replace-with-strong-development-token

# ==========================================
# API GATEWAY
# ==========================================
PORT=3000

# ==========================================
# MICROSERVICE PORTS
# ==========================================
CATALOG_PORT=3001
ORDER_PORT=3002
ASSISTANT_PORT=3003

# ==========================================
# MICROSERVICE URLS
# ==========================================
CATALOG_URL=http://127.0.0.1:3001
ORDER_URL=http://127.0.0.1:3002
ASSISTANT_URL=http://127.0.0.1:3003

# ==========================================
# REQUEST CONFIGURATION
# ==========================================
REQUEST_TIMEOUT_MS=10000
AI_REQUEST_TIMEOUT_MS=30000
